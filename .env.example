# Telegram Bot Token (Dapatkan dari @BotFather)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# OpenAI API Key (Untuk AI Vision & AI Tactical Breakdown)
OPENAI_API_KEY=your_openai_api_key_here

# RapidAPI Key (API-Football v3 untuk data klasemen, H2H, dan statistik)
RAPIDAPI_KEY=your_rapidapi_key_here

# The Odds API Key (Untuk perbandingan odds live dan benchmark Pinnacle)
ODDS_API_KEY=your_odds_api_key_here

# Port untuk 24/7 Cloud Hosting (Render/Railway/Koyeb otomatis mengatur ini)
PORT=8080
