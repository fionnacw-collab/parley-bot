# Telegram Bot Token (Dapatkan dari @BotFather di Telegram)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Google Gemini API Key (100% GRATIS & Tanpa Kartu Kredit di https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI API Key (Opsional / Alternatif)
OPENAI_API_KEY=your_openai_api_key_here

# RapidAPI Key (Opsional: API-Football v3 untuk data klasemen dan H2H)
RAPIDAPI_KEY=your_rapidapi_key_here

# The Odds API Key (Opsional: Untuk odds live)
ODDS_API_KEY=your_odds_api_key_here

# AI Provider yang digunakan: 'gemini', 'openai', atau 'auto'
AI_PROVIDER=auto
GEMINI_MODEL=gemini-2.5-flash

# Port untuk 24/7 Cloud Hosting
PORT=8080
